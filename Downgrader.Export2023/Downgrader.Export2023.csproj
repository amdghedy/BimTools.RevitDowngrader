<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline / vendored RevitAPI: if Get-RevitApi.ps1 has downloaded ThirdParty\RevitAPI\2023\RevitAPI.dll, use it instead of the NuGet packages -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\ThirdParty\RevitAPI\2023\RevitAPI.dll') And '$(UseLocalRevitApi)' == ''">
    <RevitDir>$(MSBuildThisFileDirectory)..\ThirdParty\RevitAPI\2023</RevitDir>
    <UseLocalRevitApi>true</UseLocalRevitApi>
  </PropertyGroup>
  <!-- Revit 2023 add-in. Override the install path with:  msbuild /p:RevitDir="D:\Autodesk\Revit 2023" -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Downgrader.Export2023</AssemblyName>
    <RootNamespace>Downgrader.Export</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);REVIT2022_OR_NEWER;REVIT2023_OR_NEWER</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit 2023</RevitDir>
    <AddinsDir>$(APPDATA)\Autodesk\Revit\Addins\2023</AddinsDir>
    <!-- false (default): RevitAPI / RevitAPIUI come from NuGet, no Revit install needed to build.  true: use the DLLs in RevitDir. -->
    <UseLocalRevitApi Condition="'$(UseLocalRevitApi)' == ''">false</UseLocalRevitApi>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalRevitApi)' != 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRevitApi)' == 'true'">
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="..\Downgrader.Core\Downgrader.Core.csproj" />
    <Compile Include="..\Downgrader.Export2022\*.cs" Link="Source\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <None Include="Downgrader.Export2023.addin" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <Target Name="DeployAddin" AfterTargets="Build">
    <Copy SourceFiles="Downgrader.Export2023.addin" DestinationFolder="$(AddinsDir)" />
    <Copy SourceFiles="$(OutDir)Downgrader.Export2023.dll;$(OutDir)Downgrader.Core.dll" DestinationFolder="$(AddinsDir)\Downgrader" />
  </Target>
</Project>
